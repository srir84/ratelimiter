// Token bucket refill, per-attempt deductions, and capped failure refunds.
digraph budget {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.45, ranksep=0.4, fontname="Helvetica", fontsize=18, dpi=160];
  node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#667085", fontname="Helvetica", fontsize=18, margin="0.18,0.15", penwidth=1.2];
  edge [color="#667085", fontname="Helvetica", fontsize=14, arrowsize=0.75];
  refill [label="Continuous refill\n10 tokens / second"];
  bucket [shape=cylinder, label="One key's shared bucket\n0 to 20 tokens", fillcolor="#E8F1FF", color="#3264A8"];
  work [label="Allowed attempt\nSpend 1 token + get receipt"];
  settled [label="Success: keep the charge\nServer failure: refund once"];
  refill -> bucket;
  bucket -> work [label="If at least 1 token"];
  work -> settled;
  settled -> bucket [label="Refund capped at 20", constraint=false];
}

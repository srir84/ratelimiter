// Harness components: three API processes, each embedding our limiter, share one budget store.
digraph components {
  graph [rankdir=TB, compound=true, ordering=out, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.55, fontname="Helvetica", fontsize=18, dpi=160];
  node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#667085", fontname="Helvetica", fontsize=18, margin="0.2,0.16", penwidth=1.2];
  edge [color="#667085", fontname="Helvetica", fontsize=14, arrowsize=0.75];
  subgraph cluster_laptop {
    label="One laptop (loopback only)"; color="#D0D5DD"; style="rounded"; margin=20;
    traffic [label="Traffic generator\nSeeded schedule → records results"];
    subgraph cluster_a1 { label="API 2 (own port)"; color="#98A2B3"; style="rounded,dashed"; h1 [label="HTTP handler"]; l1 [label="Our limiter", fillcolor="#E8F1FF", color="#3264A8"]; h1 -> l1; }
    subgraph cluster_a2 { label="API 1 (own port)"; color="#98A2B3"; style="rounded,dashed"; h2 [label="HTTP handler"]; l2 [label="Our limiter", fillcolor="#E8F1FF", color="#3264A8"]; h2 -> l2; }
    subgraph cluster_a3 { label="API 3 (own port)"; color="#98A2B3"; style="rounded,dashed"; h3 [label="HTTP handler"]; l3 [label="Our limiter", fillcolor="#E8F1FF", color="#3264A8"]; h3 -> l3; }
    state [label="Limiter store  (ONE budget per key = user ID)\nEpoch record (+ integrity hold) · buckets · cleanup index\nExpiring refund markers · high-water mark · quarantine flags\n(controlled time value in test runs)", fillcolor="#E8F1FF", color="#3264A8"];
    db [shape=cylinder, label="Harness database\nOne row per (user_id, request_id)"];
    traffic -> h1 [label="GET /hit"]; traffic -> h2 [label="GET /hit"]; traffic -> h3 [label="GET /hit"];
    l1 -> state [label="atomic"]; l2 -> state [label="atomic"]; l3 -> state [label="atomic"];
    h1 -> db [style=dashed]; h2 -> db [style=dashed, label="if allowed"]; h3 -> db [style=dashed];
    admin [label="Admin tool\nstart epoch (each run)", fillcolor="#E8F1FF", color="#3264A8"];
    orch [label="Orchestrator\none command per run"];
    orch -> admin; admin -> state [label="epoch record"];
    {rank=same; state; db;}
  }
  legend [shape=note, fontsize=13, fillcolor="#FFFFFF", label="Blue = the product (our limiter)\nGrey = test harness\nDashed arrow = only after an allow"];
}
